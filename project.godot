; Engine configuration file.
config_version=5

[application]

config/name="Frostgame"
config/description="Frostgrave skirmish simulator for phones, with automated rules."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
run/flush_stdout_on_print=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=0
lights_and_shadows/directional_shadow/size.mobile=1024
